import pandas as pd
import matplotlib.pyplot as plt
import os

# 1. 路徑與數據讀取
script_dir = os.path.dirname(os.path.abspath(__file__))
file_path = os.path.join(script_dir, 'raw_data', 'SparkBody_Data - 工作表4.tsv')
output_png = os.path.join(script_dir, 'fig3_red_blue_contrast.png')

df = pd.read_csv(file_path, sep='\t')
# 選取 Heart 動作的前 25 點 (最抖動片段)
raw_flow = df[df['activity'] == 'Heart']['flow'].iloc[:25].values.copy()

# 2. 計算 EMA (α=0.15)
alpha = 0.15
ema_flow = [raw_flow[0]]
for i in range(1, len(raw_flow)):
    ema_flow.append(alpha * raw_flow[i] + (1 - alpha) * ema_flow[-1])

# 3. 繪製 IEEE 單欄標準圖表 (3.5" x 2.2")
plt.figure(figsize=(3.5, 2.2), dpi=400) # 提高 DPI 確保清晰
plt.rcParams.update({
    'font.family': 'serif',
    'font.size': 8,
    'axes.linewidth': 0.6
})

# --- 關鍵修正：紅藍強烈對比 ---
# 1. 原始訊號 (No EMA)：紅色虛線 + X 標記，代表「躁動、不穩定」
plt.plot(raw_flow, 'x--', color='#e74c3c', linewidth=0.8, 
         markersize=3, alpha=0.7, label='Without EMA (Jittery)')

# 2. 濾波訊號 (With EMA)：深藍色實線 + 圓點，代表「穩定、專業」
plt.plot(ema_flow, 'o-', color='#1f77b4', linewidth=1.5, 
         markersize=3, label=r'With EMA ($\alpha=0.15$)')

# --- 解決遮擋：拉高 Y 軸頂部空間 ---
y_max = max(max(raw_flow), max(ema_flow))
plt.ylim(min(raw_flow)*0.8, y_max * 1.35) 

# --- 圖例與標籤 (簡潔優雅) ---
# 拿掉框框，放在最空的左上角
plt.legend(frameon=False, fontsize=7, loc='upper left') 

plt.xlabel('Frame Sequence (at 30 FPS)', fontsize=8)
plt.ylabel('Flow Magnitude', fontsize=8)
# plt.title('Fig 3. Stabilization Analysis', fontsize=9, fontweight='bold', pad=10) # 論文通常不在圖內加標題

plt.grid(True, linestyle=':', linewidth=0.5, alpha=0.5)

# 移除上方與右方邊框 (學術簡約風)
plt.gca().spines['top'].set_visible(False)
plt.gca().spines['right'].set_visible(False)

# 4. 緊湊排版並存檔
plt.tight_layout()
plt.savefig(output_png, bbox_inches='tight', pad_inches=0.02)
plt.show()

print(f"✅ 紅藍對比 Fig 3 已生成：{output_png}")