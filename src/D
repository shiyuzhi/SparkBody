import matplotlib.pyplot as plt
import matplotlib.patches as mpatches
import numpy as np

plt.rcParams["font.family"] = "sans-serif"
plt.rcParams["font.sans-serif"] = ["Arial"]
plt.rcParams["mathtext.default"] = "regular"

SW          = 1.0
EMA_ALPHA   = 0.15
MAX_JERK    = 0.025
MIN_SPAN    = SW * 2.5
ARM_EXT     = SW * 1.1
FLAP_SPEED  = SW * 0.12
COOLDOWN_MS = 1000
TOTAL       = 16

KEY_FRAMES = [0, 4, 10, 11, 13, 15]
LABELS = ["Resting",
          "Raising\n$(0.8\\times SW)$",
          "Peak Spread\n$(2.8\\times SW)$",
          "Flap Onset",
          "Triggered",
          "Complete"]

def build_paths():
    y_raise = np.linspace(0.8, -0.2, 11)
    y_flap  = np.linspace(-0.2, 0.6, 5)
    y_path  = np.concatenate([y_raise, y_flap])
    x_raise = np.linspace(0.05, 0.9 * SW, 11)
    x_flat  = np.full(5, 0.9 * SW)
    x_path  = np.concatenate([x_raise, x_flat])
    return x_path, y_path

def compute_lma_series(x_path, y_path):
    A   = EMA_ALPHA
    MJ  = MAX_JERK
    ema = {}
    prev_y, prev_vy = None, None
    results = []

    for f in range(TOTAL):
        lhx = -SW / 2 - x_path[f]
        rhx =  SW / 2 + x_path[f]
        lhy = y_path[f]

        raw_shape = abs(lhx - rhx) / SW
        ema["shape"] = raw_shape if "shape" not in ema else A * raw_shape + (1 - A) * ema["shape"]
        s_shape = ema["shape"]

        raw_weight, raw_jerk, has_vel = 0.0, 0.0, False
        if prev_y is not None:
            vel  = lhy - prev_y
            dvel = vel - (prev_vy if prev_vy is not None else vel)
            if abs(vel) <= 0.15:
                raw_weight = abs(vel)
                raw_jerk   = abs(dvel)
                has_vel    = True
            prev_vy = vel
        else:
            prev_vy = None

        ema["weight"] = raw_weight if "weight" not in ema else A * raw_weight + (1 - A) * ema["weight"]
        s_weight = ema["weight"]

        flow_val = max(0.0, min(1.0, 1 - raw_jerk / MJ)) if has_vel else 0.5
        ema["flow"] = flow_val if "flow" not in ema else A * flow_val + (1 - A) * ema["flow"]
        s_flow = ema["flow"]

        nw = min(1.0, s_weight / 0.08)
        nf = s_flow
        ns = min(1.0, s_shape / 4.0)
        kt = 0.40 * nw + 0.35 * (1 - nf) + 0.25 * ns

        results.append(dict(shape=ns, weight=nw, flow=nf, kt=kt))
        prev_y = lhy

    return results

def get_pose(f, x_path, y_path):
    LSX, RSX, SY = -SW / 2, SW / 2, 0.0
    lhx = LSX - x_path[f]
    rhx = RSX + x_path[f]
    lhy = rhy = SY + y_path[f]

    wingspan    = abs(lhx - rhx)
    leftArmExt  = abs(lhx - LSX)
    rightArmExt = abs(rhx - RSX)

    avgDY = (SY + y_path[f - 1]) - lhy if f > 0 else 0.0

    handsAreHigh = lhy < SY
    isExtended   = leftArmExt > ARM_EXT and rightArmExt > ARM_EXT
    triggered    = (f >= 12
                    and wingspan > MIN_SPAN
                    and avgDY < -FLAP_SPEED)


    return dict(LSX=LSX, RSX=RSX, SY=SY,
                lhx=lhx, rhx=rhx, lhy=lhy, rhy=rhy,
                wingspan=wingspan, avgDY=avgDY,
                handsAreHigh=handsAreHigh, isExtended=isExtended,
                triggered=triggered)

def draw_stick(ax, p, frame_idx, x_path, y_path, first_trigger=None):
    C_BODY = "#7F8C8D"
    C_ARM  = "#2980B9" if not p["triggered"] else "#C0392B"
    C_SPAN = "#D35400"
    C_VEL  = "#E74C3C"
    kw = dict(solid_capstyle="round", solid_joinstyle="round")





    head = mpatches.Circle((0, p["SY"] - 0.35), 0.14,
                            fill=True, facecolor="white",
                            edgecolor=C_BODY, linewidth=2, zorder=4)
    ax.add_patch(head)

    HY = p["SY"] + 1.2
    ax.plot([0, 0],     [p["SY"], HY],    color=C_BODY, lw=2.5, zorder=2, **kw)
    ax.plot([-0.18, 0], [HY+0.5, HY],    color=C_BODY, lw=2.5, zorder=2, **kw)
    ax.plot([ 0.18, 0], [HY+0.5, HY],    color=C_BODY, lw=2.5, zorder=2, **kw)
    ax.plot([p["LSX"], p["RSX"]], [p["SY"], p["SY"]], color=C_BODY, lw=2.5, zorder=2, **kw)
    ax.plot([p["LSX"], p["lhx"]], [p["SY"], p["lhy"]], color=C_ARM, lw=3.5, zorder=3, **kw)
    ax.plot([p["RSX"], p["rhx"]], [p["SY"], p["rhy"]], color=C_ARM, lw=3.5, zorder=3, **kw)

    for jx in [p["LSX"], p["RSX"]]:
        ax.plot(jx, p["SY"], "o", color="white",
                markeredgecolor=C_BODY, markeredgewidth=1.5, markersize=6, zorder=4)
    ax.plot(p["lhx"], p["lhy"], "o", color=C_ARM, markersize=8, zorder=5)
    ax.plot(p["rhx"], p["rhy"], "o", color=C_ARM, markersize=8, zorder=5)

    if 2 <= frame_idx <= 10 and p["wingspan"] > MIN_SPAN * 0.6:
        sy = p["lhy"] + 0.2
        ax.annotate("", xy=(p["rhx"], sy), xytext=(p["lhx"], sy),
                    arrowprops=dict(arrowstyle="<|-|>", color=C_SPAN, lw=1.2, mutation_scale=10))
        ax.text(0, sy + 0.08, f"${p['wingspan']/SW:.1f}\\times SW$",
                ha="center", va="top", fontsize=8, color=C_SPAN, fontweight="bold")

    if frame_idx >= 12 and p["avgDY"] < -FLAP_SPEED:
        for hx, hy in [(p["lhx"], p["lhy"]), (p["rhx"], p["rhy"])]:
            ax.annotate("", xy=(hx, hy+0.25), xytext=(hx, hy+0.05),
                        arrowprops=dict(arrowstyle="-|>", color=C_VEL, lw=1.5, mutation_scale=14))

    if p["triggered"]:
        label_text  = "TRIGGERED" if frame_idx == first_trigger else "SUSTAINING"
        label_color = "#C0392B"   if frame_idx == first_trigger else "#884400"
        ax.text(0, p["SY"] - 0.75, label_text,
                ha="center", va="center", fontsize=8, color="white", fontweight="bold",
                bbox=dict(boxstyle="round,pad=0.3", fc=label_color, ec="none"))

def make_figure():
    x_path, y_path = build_paths()
    lma_series = compute_lma_series(x_path, y_path)
    n = len(KEY_FRAMES)

    fig = plt.figure(figsize=(16, 9))
    fig.patch.set_facecolor("white")
    gs = fig.add_gridspec(2, n, height_ratios=[1, 0.08],
                          top=0.88, bottom=0.08, hspace=0.0,
                          left=0.02, right=0.98, wspace=0.05)

    first_trigger = min(
        (f for f in KEY_FRAMES if get_pose(f, x_path, y_path)["triggered"]),
        default=None
    )

    for col, (fi, label) in enumerate(zip(KEY_FRAMES, LABELS)):
        ax = fig.add_subplot(gs[0, col])
        p  = get_pose(fi, x_path, y_path)
        draw_stick(ax, p, fi, x_path, y_path, first_trigger)

        ax.set_xlim(-2.0, 2.0)
        ax.set_ylim(-0.9, 2.0)
        ax.set_aspect("equal")
        ax.axis("off")
        ax.invert_yaxis()

        ax.text(0.5, 0.98, f"$f={fi:02d}$", transform=ax.transAxes,
                ha="center", va="top", fontsize=9, color="#7F8C8D")
        ax.set_title(label, fontsize=10, pad=10, color="#2C3E50",
                     fontweight="bold", linespacing=1.5)

        badges = []
        if p["handsAreHigh"]:         badges.append("$y_h < y_s$")
        if p["wingspan"] >= MIN_SPAN: badges.append(r"$\geq 2.5\,SW$")
        if p["triggered"]:            badges.append("$|\\bar{v}_{dy}|>0.12SW$")
        if badges:
            ax.text(0.5, -0.02, "   ".join(badges),
                    transform=ax.transAxes, ha="center", va="top",
                    fontsize=8, color="#34495E",
                    bbox=dict(facecolor="#F2F3F4", edgecolor="none", boxstyle="round,pad=0.4"))

        ax_lma = fig.add_subplot(gs[1, col])
        ax_lma.axis("off")
        lma = lma_series[fi]
        prev_lma = lma_series[fi - 1] if fi > 0 else None

        def trend(key, cur, prev):
            if prev is None: return "—"
            d = cur[key] - prev[key]
            if d > 0.02:  return "↑"
            if d < -0.02: return "↓"
            return ""

        rows = [
            ("Space",  trend("shape",  lma, prev_lma), "#2980B9"),
            ("Weight", trend("weight", lma, prev_lma), "#D35400"),
            ("Flow",   trend("flow",   lma, prev_lma), "#27AE60"),
            ("KT",     trend("kt",     lma, prev_lma), "#8E44AD"),
        ]
        for r, (name, arrow, color) in enumerate(rows):
            ax_lma.text(0.08, 1 - r*0.28, name,
                        transform=ax_lma.transAxes, fontsize=8,
                        color="#7F8C8D", va="top", fontweight="bold")
            ax_lma.text(0.5, 1 - r*0.28, arrow,
                        transform=ax_lma.transAxes, fontsize=11, color=color,
                        va="top", ha="center", fontweight="bold")

    fig.suptitle("Frame-by-Frame Kinematic Analysis of the Gull Flap Gesture",
                 fontsize=14, y=1.01, color="#2C3E50", fontweight="bold",
                 fontfamily="Arial")
    plt.savefig("gull_flap_breakdown.pdf", bbox_inches="tight", dpi=300)
    plt.savefig("gull_flap_breakdown.png", bbox_inches="tight", dpi=300)
    print("Saved: gull_flap_breakdown.pdf / .png")

make_figure()